<!--
  Home intro overlay (docs/MOTION.md moment 1). Hidden unless the inline IntroGate added html.intro,
  so it never shows without JavaScript or for reduced motion. The hero below is the real content.
-->
<div class="intro-overlay" data-intro>
  <div class="intro-stage" data-intro-stage aria-hidden="true"></div>
  <button type="button" class="intro-skip" data-intro-skip>
    Skip intro
  </button>
</div>

<script>
  import { runIntro } from "@/lib/motion/moments/intro";

  runIntro();
</script>

<style>
  .intro-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: var(--z-intro);
    background-color: var(--color-bg-void);
    touch-action: none;
  }

  :global(html.intro) .intro-overlay {
    display: block;
  }

  /* Esc before the intro bundle loads: hide at once and stop blocking the page. */
  :global(html.intro-skipped) .intro-overlay {
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms var(--ease-out);
  }

  .intro-stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .intro-stage :global(.intro-2d) {
    position: absolute;
    top: 0;
    left: 0;
    border-radius: 50%;
    pointer-events: none;
    /* Large soft gradients moved every frame for under 2 s: promote them so they are never repainted. */
    will-change: transform, opacity;
  }

  .intro-stage :global(.intro-canvas) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .intro-skip {
    position: absolute;
    top: calc(env(safe-area-inset-top, 0px) + 1rem);
    right: 1rem;
    min-height: 44px;
    padding: 0.5rem 1.125rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-surface);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-text);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: box-shadow var(--duration-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .intro-skip:hover {
      box-shadow: inset 0 0 0 1px var(--color-text);
    }
  }
</style>
