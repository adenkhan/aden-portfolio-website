---
import type { Arc } from "@/data/types";

interface Props {
  arc: Arc;
}

const { arc } = Astro.props;
---

<li class="panel" id={arc.id} data-lane={arc.lane} data-arc-panel>
  <span class="edge" aria-hidden="true" data-arc-edge></span>
  <h3>
    <span class="period">{arc.period}</span>
    <span class="sep" aria-hidden="true">
      {" "}
      ·{" "}
    </span>
    <span class="org">{arc.org}</span>
  </h3>
  <p class="text">{arc.line}</p>
  <p class="chip">{arc.chip}</p>
</li>

<style>
  .panel {
    position: relative;
    padding: 1.5rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-line-strong);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 20px), calc(100% - 20px) 100%, 0 100%);
    scroll-margin-top: 2rem;
  }

  /* Lane-coloured top edge (DESIGN.md manga-panel). A separate element so it can be drawn in later. */
  .edge {
    position: absolute;
    inset: 0 0 auto;
    height: 3px;
    background-color: var(--lane-colour);
  }

  /* Halftone corner fade, About panels only. */
  .panel::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 0;
    width: 90px;
    height: 90px;
    background-image: radial-gradient(circle, rgb(242 243 250 / 0.22) 1.4px, transparent 2px);
    background-size: 9px 9px;
    mask-image: linear-gradient(135deg, transparent 40%, #000);
    pointer-events: none;
  }

  h3 {
    margin: 0 0 0.75rem;
    font-size: var(--text-title);
    line-height: var(--text-title--line-height);
    font-weight: 800;
  }

  .period {
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    font-weight: 500;
    color: var(--lane-colour);
  }

  .sep {
    font-size: var(--text-mono-label);
    color: var(--color-text-subtle);
  }

  .text {
    margin: 0;
    color: var(--color-text-muted);
  }

  /* Stat chip: the arc's one number, in its lane colour. */
  .chip {
    display: inline-block;
    margin: 1rem 0 0;
    padding: 0.25rem 0.75rem;
    border: 1px solid var(--lane-colour);
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-size: var(--text-body-lg);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    color: var(--lane-colour);
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }
</style>
