---
import { worstArcs } from "@/data/fixtures/worst";
import { about } from "@/data/timeline";
import { isWorstCase } from "@/lib/fixtures";
import ArcPanel from "./ArcPanel.astro";
const arcs = isWorstCase() ? worstArcs : about.arcs;
---

<section class="container-site block" aria-labelledby="arcs-title">
  <h2 id="arcs-title" class="sr-only">
    {about.arcsHeading}
  </h2>
  <ol class="panels">
    {arcs.map((arc) => (
      <ArcPanel arc={arc} />
    ))}
  </ol>
</section>

<style>
  .block {
    padding-block: 4rem 0;
  }

  .panels {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (width >= 48rem) {
    .panels {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
