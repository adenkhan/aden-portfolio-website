---
import { site } from "@/data/site";
import { contact } from "@/data/timeline";

const { form } = contact;
---

<section class="container-site block" id="message" aria-labelledby="message-title">
  <h2 id="message-title">{contact.messageHeading}</h2>
  <p class="lead">
    {form.lead} <a href={`mailto:${site.email}`}>{site.email}</a>.
  </p>

  <!-- Netlify Forms reads this static form at deploy time (docs/ENGINEERING-PLAN.md §10). -->
  <form name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact" />
    <p hidden>
      <label>
        Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <div class="field">
      <label for="contact-name">{form.name}</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" required />
    </div>
    <div class="field">
      <label for="contact-email">{form.email}</label>
      <input id="contact-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for="contact-message">{form.message}</label>
      <textarea id="contact-message" name="message" rows="6" required></textarea>
    </div>
    <button type="submit">{form.submit}</button>
  </form>
</section>

<style>
  .block {
    padding-block: 4rem 0;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
  }

  .lead {
    margin: 0 0 2rem;
    color: var(--color-text-muted);
  }

  .lead a {
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  form {
    display: grid;
    gap: 1.25rem;
    max-width: 720px;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font: inherit;
    transition: border-color var(--duration-hover) ease;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-focus);
  }

  button {
    justify-self: start;
    min-height: 48px;
    padding: 0.625rem 1.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-creative);
    color: var(--color-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-hover) ease,
      transform var(--duration-press) ease-out;
  }

  button:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover,
    textarea:hover {
      border-color: var(--color-text-muted);
    }

    button:hover {
      background-color: color-mix(in oklab, var(--color-creative), white 8%);
    }
  }
</style>
