---
import { contact } from "@/data/timeline";

const { form } = contact;
---

<section class="container-site block" id="message" aria-labelledby="message-title">
  <h2 id="message-title" class="sr-only">
    {contact.messageHeading}
  </h2>

  <!-- Netlify Forms reads this static form at deploy time (docs/ENGINEERING-PLAN.md §10). -->
  <!--
    Without JavaScript the browser's own validation (required, type="email") applies. With it, the
    script below switches to inline errors linked by aria-describedby and a live summary.
  -->
  <form
    name="contact"
    method="POST"
    action="/thanks/"
    data-netlify="true"
    netlify-honeypot="bot-field"
    data-contact-form
    data-error-name={form.errors.name}
    data-error-email={form.errors.email}
    data-error-email-format={form.errors.emailFormat}
    data-error-message={form.errors.message}
    data-summary={form.summary}
    data-sending={form.sending}
  >
    <input type="hidden" name="form-name" value="contact" />
    <p hidden>
      <label>
        Leave this field empty <input name="bot-field" tabindex="-1" autocomplete="off" />
      </label>
    </p>

    <p class="status" role="status" aria-live="polite" data-form-status></p>

    <div class="field">
      <label for="contact-name">{form.name}</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        aria-describedby="contact-name-error"
      />
      <p class="error" id="contact-name-error" hidden></p>
    </div>
    <div class="field">
      <label for="contact-email">{form.email}</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        spellcheck="false"
        autocapitalize="none"
        required
        aria-describedby="contact-email-error"
      />
      <p class="error" id="contact-email-error" hidden></p>
    </div>
    <div class="field">
      <label for="contact-message">{form.message}</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        aria-describedby="contact-message-error"
      ></textarea>
      <p class="error" id="contact-message-error" hidden></p>
    </div>
    <button type="submit">{form.submit}</button>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");

  if (form) {
    const copy = form.dataset;
    const status = form.querySelector<HTMLElement>("[data-form-status]")!;
    const fields = ["contact-name", "contact-email", "contact-message"].map((id) =>
      form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`#${id}`)!,
    );
    let attempted = false;

    // Our messages replace the browser bubbles once JavaScript runs.
    form.noValidate = true;

    const messageFor = (field: HTMLInputElement | HTMLTextAreaElement): string => {
      const value = field.value.trim();
      if (field.name === "name") return value ? "" : copy.errorName!;
      if (field.name === "email") {
        if (!value) return copy.errorEmail!;
        return (field as HTMLInputElement).validity.typeMismatch || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
          ? copy.errorEmailFormat!
          : "";
      }
      return value ? "" : copy.errorMessage!;
    };

    const check = (field: HTMLInputElement | HTMLTextAreaElement): boolean => {
      const message = messageFor(field);
      const error = form.querySelector<HTMLElement>(`#${field.id}-error`)!;
      error.textContent = message;
      error.hidden = !message;
      field.setAttribute("aria-invalid", message ? "true" : "false");
      return !message;
    };

    form.addEventListener("submit", (event) => {
      attempted = true;
      const invalid = fields.filter((field) => !check(field));
      if (!invalid.length) {
        status.textContent = "";
        // Valid: the browser posts the form to Netlify, which redirects to /thanks/. Show progress and
        // stop a second press while the request is in flight.
        const button = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
        button.textContent = copy.sending!;
        queueMicrotask(() => (button.disabled = true));
        return;
      }
      event.preventDefault();
      const labels = invalid.map((field) =>
        form.querySelector(`label[for="${field.id}"]`)?.textContent?.trim(),
      );
      status.textContent = copy
        .summary!.replace("{count}", invalid.length === 1 ? "1 field" : `${invalid.length} fields`)
        .replace("{fields}", labels.join(", "));
      invalid[0].focus();
    });

    // After the first attempt, errors update as the visitor fixes each field.
    for (const field of fields) {
      field.addEventListener("input", () => attempted && check(field));
      field.addEventListener("blur", () => attempted && check(field));
    }
  }
</script>

<style>
  .block {
    padding-block: 4rem 0;
  }

  form {
    display: grid;
    gap: 1.25rem;
    max-width: 720px;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  label {
    font-weight: 600;
  }

  input,
  textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font: inherit;
    transition: border-color var(--duration-hover) ease;
  }

  textarea {
    resize: vertical;
  }

  input:focus-visible,
  textarea:focus-visible {
    border-color: var(--color-focus);
  }

  input[aria-invalid="true"],
  textarea[aria-invalid="true"] {
    border-color: var(--color-creative);
  }

  /* Error text in the creative red: 5.59:1 on the surface colour. The text says what to fix. */
  .error {
    margin: 0;
    color: var(--color-creative);
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
  }

  .status {
    margin: 0;
    color: var(--color-text);
    font-weight: 600;
  }

  .status:empty {
    display: none;
  }

  button {
    justify-self: start;
    min-height: 48px;
    padding: 0.625rem 1.5rem;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--color-creative);
    color: var(--color-on-accent);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color var(--duration-hover) ease,
      transform var(--duration-press) ease-out;
  }

  button:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    input:hover,
    textarea:hover {
      border-color: var(--color-text-muted);
    }

    button:hover {
      background-color: color-mix(in oklab, var(--color-creative), white 8%);
    }
  }
</style>
