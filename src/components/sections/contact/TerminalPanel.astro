---
import { site } from "@/data/site";
import { contact } from "@/data/timeline";

const rows = [
  { key: "email", label: site.email, href: `mailto:${site.email}`, external: false },
  { key: "linkedin", label: "linkedin.com/in/adenkhank", href: site.linkedin, external: true },
  { key: "github", label: "github.com/adenkhan", href: site.github, external: true },
];
---

<section class="container-site block" aria-labelledby="channels-title">
  <h2 id="channels-title" class="sr-only">
    {contact.channelsHeading}
  </h2>
  <!--
    Each link keeps its real text for screen readers (sr-only) and shows an aria-hidden copy that
    the motion layer "types" in (MOTION.md §12). Without JavaScript the copy simply shows.
  -->
  <div class="terminal">
    <dl>
      {rows.map((row) => (
        <div class="row">
          <dt>{row.key}</dt>
          <dd>
            <a href={row.href} {...(row.external ? { target: "_blank", rel: "me noopener" } : {})}>
              <span class="sr-only">{row.label}</span>
              <span aria-hidden="true" data-type>
                {row.label}
              </span>
            </a>
            {row.key === "email" && (
              <button type="button" class="copy" data-copy-email={site.email} hidden>
                {contact.copy.button}
              </button>
            )}
          </dd>
        </div>
      ))}
      <div class="row">
        <dt>cv</dt>
        <dd>
          <a href={site.cvPath} download>
            <span class="sr-only">{site.cvLabel} (PDF)</span>
            <span aria-hidden="true" data-type>
              {site.cvLabel} (PDF)
            </span>
          </a>
        </dd>
      </div>
    </dl>
  </div>
  <div class="toast" role="status" aria-live="polite" data-toast></div>
</section>

<script>
  import { onPage } from "@/lib/page";

  // Copy-email button (shown only with JavaScript) and a small toast. No library: Sonner is React.
  // Bound per page, since the client router can bring Contact in without a reload.
  onPage(() => {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
    const toast = document.querySelector<HTMLElement>("[data-toast]");
    const strings = document.querySelector<HTMLElement>("[data-copy-strings]")?.dataset;
    let timer: ReturnType<typeof setTimeout> | undefined;

    const show = (message: string) => {
      if (!toast) return;
      toast.textContent = message;
      toast.classList.add("visible");
      clearTimeout(timer);
      timer = setTimeout(() => toast.classList.remove("visible"), 2400);
    };

    if (button && toast && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener("click", async () => {
        const email = button.dataset.copyEmail ?? "";
        try {
          await navigator.clipboard.writeText(email);
          show(strings?.done ?? "Email copied");
        } catch {
          show(`${strings?.failed ?? "Could not copy. The address is"} ${email}`);
        }
      });
    }
    return () => clearTimeout(timer);
  });
</script>

<span hidden data-copy-strings data-done={contact.copy.done} data-failed={contact.copy.failed}></span>

<style>
  .block {
    padding-block: 3rem 0;
  }

  .terminal {
    position: relative;
    max-width: 720px;
    padding: 1.5rem;
    background-color: var(--color-bg-void);
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    font-family: var(--font-mono);
  }

  /* HUD corner brackets: allowed on this panel only (DESIGN.md motifs). */
  .terminal::before,
  .terminal::after {
    content: "";
    position: absolute;
    width: 1rem;
    height: 1rem;
  }

  .terminal::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-creative);
    border-left: 2px solid var(--color-creative);
  }

  .terminal::after {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--color-data);
    border-bottom: 2px solid var(--color-data);
  }

  dl {
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    align-items: center;
    gap: 0.5rem;
  }

  dt {
    color: var(--color-text-subtle);
    font-size: var(--text-mono-label);
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  dd {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1rem;
  }

  dd a {
    display: inline-flex;
    align-items: center;
    min-width: 0;
    min-height: 44px;
    color: var(--color-text);
    overflow-wrap: anywhere;
  }

  .copy {
    flex-shrink: 0;
    min-height: 44px;
    padding: 0 0.875rem;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
    color: var(--color-text-muted);
    font: inherit;
    font-size: var(--text-mono-label);
    cursor: pointer;
    transition:
      color var(--duration-hover) ease,
      box-shadow var(--duration-hover) ease,
      transform var(--duration-press) ease-out;
  }

  /* Keeps its space while hidden, so showing it (once its script runs) never shifts the form below. */
  .copy[hidden] {
    display: inline-block;
    visibility: hidden;
  }

  .copy:active {
    transform: scale(0.97);
  }

  @media (hover: hover) and (pointer: fine) {
    .copy:hover {
      color: var(--color-text);
      box-shadow: inset 0 0 0 1px var(--color-text);
    }
  }

  /* Toast: enters from below in 220 ms, leaves in 150 ms; reduced motion fades only. */
  .toast {
    position: fixed;
    bottom: calc(env(safe-area-inset-bottom, 0px) + 1.5rem);
    left: 50%;
    z-index: var(--z-toast);
    max-width: calc(100vw - 2rem);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-raised);
    box-shadow: inset 0 0 0 1px var(--color-growth);
    color: var(--color-text);
    font-weight: 600;
    overflow-wrap: anywhere;
    opacity: 0;
    transform: translate(-50%, 100%);
    pointer-events: none;
    transition:
      opacity 150ms var(--ease-out),
      transform 150ms var(--ease-out);
  }

  .toast:global(.visible) {
    opacity: 1;
    transform: translate(-50%, 0);
    transition-duration: 220ms;
  }

  .toast:empty {
    padding: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .toast,
    .toast:global(.visible) {
      transform: translate(-50%, 0);
    }
  }

  @media (width < 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 0.5rem;
    }
  }
</style>
