---
import { Image } from "astro:assets";
import { getSlot } from "@/data/assets";
import { site } from "@/data/site";
import { getImageFor, isPlaceholder } from "@/lib/images";
import RiveAvatar from "@/components/motion/RiveAvatar.astro";

// Optional animated avatar: switches on when this file exists (docs/ASSETS.md).
const rive = import.meta.glob<string>("/src/assets/rive/avatar.riv", {
  query: "?url",
  import: "default",
  eager: true,
});
const riveSrc = rive["/src/assets/rive/avatar.riv"];

const avatar = getSlot("avatar");
// Each focus area takes its lane colour (DESIGN.md: the multi-colour gradient is reserved for the CV button).
const barLanes = ["both", "data", "data", "creative"] as const;
// Dev-only badge while the generated placeholder is in place; never in production builds.
const showBadge = import.meta.env.DEV && isPlaceholder("avatar");
---

<figure class="card" data-pointer-glow-host data-reveal="card" data-avatar-clear>
  <span class="glow-clip" aria-hidden="true">
    <span class="glow" data-pointer-glow></span>
  </span>
  <p class="hud">
    <span class="sr-only">{site.hudTag}</span>
    <span aria-hidden="true" data-reveal="scramble">
      {site.hudTag}
    </span>
  </p>
  <!-- The live 3D model (r9) is drawn into this box by the world, framed exactly like the poster,
       which stays the LCP image and the fallback (no JS, reduced motion, no WebGL, a failed load). -->
  <div class="avatar" data-avatar-anchor="card">
    <Image
      data-avatar-poster
      src={getImageFor("avatar")}
      alt={avatar.alt}
      width={avatar.width}
      height={avatar.height}
      widths={[400, 800, 1200]}
      sizes="(min-width: 64rem) 400px, (min-width: 48rem) 40vw, 92vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    {riveSrc && <RiveAvatar src={riveSrc} width={avatar.width} height={avatar.height} />}
    {showBadge && <span class="placeholder-badge">placeholder</span>}
    <span class="load" aria-hidden="true" data-avatar-progress></span>
  </div>
  <!-- Decorative HUD bars, one per lane colour; no labels since r2 (text is a caption only). -->
  <div class="bars" aria-hidden="true">
    {barLanes.map((lane) => (
      <i data-lane={lane} data-bar />
    ))}
  </div>
</figure>

<style>
  .card {
    position: relative;
    margin: 0;
    padding: 1rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  /* HUD corner brackets: allowed on this card only (DESIGN.md motifs). */
  .card::before,
  .card::after {
    content: "";
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .card::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-creative);
    border-left: 2px solid var(--color-creative);
    border-top-left-radius: var(--radius-md);
  }

  .card::after {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--color-data);
    border-bottom: 2px solid var(--color-data);
    border-bottom-right-radius: var(--radius-md);
  }

  /* Pointer light (docs/MOTION.md 7b): positioned by transform only, hidden until the pointer enters. */
  .glow-clip {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    top: -120px;
    left: -120px;
    z-index: 0;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(167 124 255 / 0.28), transparent 70%);
    opacity: 0;
    pointer-events: none;
  }

  .hud,
  .avatar,
  .bars {
    position: relative;
    z-index: 1;
  }

  .hud {
    margin: 0 0 0.75rem;
    /* The scramble swaps spaces for 0/1 mid-animation; allow breaks so it never overflows at 360px. */
    overflow-wrap: anywhere;
    /* The scramble rewrites text for 0.5 s; contain keeps that layout and paint inside this label. */
    contain: layout paint;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    line-height: var(--text-mono-label--line-height);
    color: var(--color-text-muted);
  }

  .avatar {
    position: relative;
  }

  .avatar img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  /* Live (r9): the card lets the canvas through (the world paints its colour behind her) and the
     poster fades out over the model. */
  .card:global(.is-live) {
    background-color: transparent;
  }

  .avatar img {
    transition: opacity 400ms var(--ease-out);
  }

  .card:global(.is-live) .avatar img {
    opacity: 0;
  }

  /* Model download progress: a hairline under the poster; gone once she is live or not coming. */
  .load {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-creative), var(--color-growth), var(--color-data));
    transform: scaleX(var(--p, 0));
    transform-origin: left center;
    transition: transform 200ms linear;
  }

  :global(html[data-avatar]) .load,
  :global(html[data-motion="reduced"]) .load {
    display: none;
  }

  .placeholder-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-void);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .bars {
    display: grid;
    gap: 0.625rem;
    margin: 1rem 0 0;
  }

  .bars [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  .bars [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  .bars [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }

  /* Equal-length decoration, not a rating (brief decision 10). */
  .bars i {
    display: block;
    height: 2px;
    background-color: var(--lane-colour);
  }
</style>
