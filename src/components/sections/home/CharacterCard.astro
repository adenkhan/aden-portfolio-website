---
import { Image } from "astro:assets";
import { getSlot } from "@/data/assets";
import { home } from "@/data/home";
import { site } from "@/data/site";
import { getImageFor, isPlaceholder } from "@/lib/images";

const avatar = getSlot("avatar");
// Dev-only badge while the generated placeholder is in place; never in production builds.
const showBadge = import.meta.env.DEV && isPlaceholder("avatar");
---

<figure class="card" data-pointer-glow-host>
  <span class="glow-clip" aria-hidden="true">
    <span class="glow" data-pointer-glow></span>
  </span>
  <p class="hud">
    <span class="sr-only">{site.hudTag}</span>
    <span aria-hidden="true" data-reveal="scramble">
      {site.hudTag}
    </span>
  </p>
  <div class="avatar">
    <Image
      src={getImageFor("avatar")}
      alt={avatar.alt}
      width={avatar.width}
      height={avatar.height}
      widths={[360, 560, 840]}
      sizes="(min-width: 64rem) 400px, (min-width: 48rem) 40vw, 92vw"
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="sync"
    />
    {showBadge && <span class="placeholder-badge">placeholder</span>}
  </div>
  <ul class="bars" aria-label="Focus areas">
    {home.statBars.map((label) => (
      <li>
        <span>{label}</span>
        <i aria-hidden="true" />
      </li>
    ))}
  </ul>
</figure>

<style>
  .card {
    position: relative;
    margin: 0;
    padding: 1rem;
    background-color: var(--color-bg-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  /* HUD corner brackets: allowed on this card only (DESIGN.md motifs). */
  .card::before,
  .card::after {
    content: "";
    position: absolute;
    width: 1.25rem;
    height: 1.25rem;
    pointer-events: none;
  }

  .card::before {
    top: -1px;
    left: -1px;
    border-top: 2px solid var(--color-creative);
    border-left: 2px solid var(--color-creative);
    border-top-left-radius: var(--radius-md);
  }

  .card::after {
    right: -1px;
    bottom: -1px;
    border-right: 2px solid var(--color-data);
    border-bottom: 2px solid var(--color-data);
    border-bottom-right-radius: var(--radius-md);
  }

  /* Pointer light (docs/MOTION.md 7b): positioned by transform only, hidden until the pointer enters. */
  .glow-clip {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    border-radius: inherit;
    pointer-events: none;
  }

  .glow {
    position: absolute;
    top: -120px;
    left: -120px;
    z-index: 0;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(167 124 255 / 0.28), transparent 70%);
    opacity: 0;
    pointer-events: none;
  }

  .hud,
  .avatar,
  .bars {
    position: relative;
    z-index: 1;
  }

  .hud {
    margin: 0 0 0.75rem;
    /* The scramble swaps spaces for 0/1 mid-animation; allow breaks so it never overflows at 360px. */
    overflow-wrap: anywhere;
    /* The scramble rewrites text for 0.5 s; contain keeps that layout and paint inside this label. */
    contain: layout paint;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    line-height: var(--text-mono-label--line-height);
    color: var(--color-text-muted);
  }

  .avatar {
    position: relative;
  }

  .avatar img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  .placeholder-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-void);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .bars {
    display: grid;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .bars li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    color: var(--color-text-muted);
  }

  .bars span {
    min-width: 6.5rem;
  }

  /* Equal-length decoration, not a rating (brief decision 10). */
  .bars i {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--color-creative), var(--color-growth), var(--color-data));
  }
</style>
