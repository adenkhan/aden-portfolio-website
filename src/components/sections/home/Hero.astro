---
import Button from "@/components/ui/Button.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { home } from "@/data/home";
import { site } from "@/data/site";
import CharacterCard from "./CharacterCard.astro";
import StatsStrip from "./StatsStrip.astro";
---

<section class="container-site hero" aria-labelledby="hero-title">
  <div class="copy">
    <div id="hero-title" class="title">
      <PageTitle page="home" reveal />
    </div>
    <p class="sub" data-reveal="rise">
      {home.line}
    </p>
    <div class="cta" data-reveal="rise">
      <Button href={home.missionsCta.href}>{home.missionsCta.label}</Button>
      <Button href={site.cvPath} variant="secondary" download data-cv-trigger>
        {home.cvCta}
      </Button>
    </div>
  </div>
  <div class="proof">
    <StatsStrip />
  </div>
  <div class="visual">
    <div class="particles" data-ambient-particles aria-hidden="true"></div>
    <CharacterCard />
  </div>
</section>

<style>
  /* Phones: copy, then the proof strip, then the avatar card, so the proof is in the first screen. */
  .hero {
    display: grid;
    grid-template-areas:
      "copy"
      "proof"
      "visual";
    gap: 1.25rem;
    padding-block: 1rem 3rem;
  }

  .copy {
    grid-area: copy;
  }

  .proof {
    grid-area: proof;
  }

  .title :global(.page-title) {
    font-size: var(--text-display-xl);
    line-height: var(--text-display-xl--line-height);
  }

  .sub {
    margin: 1rem 0 0;
    max-width: 36ch;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-muted);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  /* Narrow phones: slightly tighter pills keep both CTAs on one row down to 360px. */
  @media (width < 30rem) {
    .cta :global(.btn) {
      padding-inline: 1.125rem;
    }
  }

  .visual {
    grid-area: visual;
    position: relative;
    width: 100%;
    max-width: 420px;
  }

  /* Ambient particles host (docs/MOTION.md 7a). Decorative; tsParticles draws a canvas here on the full tier. */
  .particles {
    position: absolute;
    inset: -2rem 0;
    z-index: 0;
    pointer-events: none;
  }

  .visual > :global(.card) {
    position: relative;
    z-index: 1;
  }

  @media (width >= 48rem) {
    .hero {
      grid-template-columns: 1.2fr 0.8fr;
      grid-template-areas:
        "copy visual"
        "proof proof";
      align-items: center;
      gap: 3rem;
      padding-block: 4rem;
    }

    .visual {
      justify-self: end;
    }

    /* Desktop has room: restore the looser rhythm. */
    .sub {
      margin-top: 1.5rem;
    }

    .cta {
      margin-top: 2rem;
    }
  }

  /* Desktop: the proof sits under the copy in the left column, beside the card, so it clears the fold. */
  @media (width >= 64rem) {
    .hero {
      grid-template-areas:
        "copy visual"
        "proof visual";
      align-items: start;
      /* Top-aligned (not centred across both rows), so the counting stats can never move the card. */
      row-gap: 2.5rem;
    }
  }
</style>
