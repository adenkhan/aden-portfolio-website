---
import { stats } from "@/data/stats";
---

<!-- Lives inside the hero so the proof sits in the first screen on phones (p16 recruiter test). -->
<div class="stats" role="group" aria-labelledby="stats-title">
  <h2 id="stats-title" class="sr-only">
    Product marketing results in numbers
  </h2>
  <dl class="strip">
    {stats.map((stat) => (
      <div class="stat" data-lane={stat.lane} data-stat>
        <dt>{stat.label}</dt>
        <dd>
          {/* Meter (r5): draws the same real number. Decorative; the value is read as text. */}
          {stat.meter.kind === "ring" && (
            <svg
              class="meter"
              viewBox="0 0 40 40"
              aria-hidden="true"
              focusable="false"
              data-meter="ring"
              data-percent={stat.meter.percent}
            >
              <circle cx="20" cy="20" r="16" class="track" />
              <circle
                cx="20"
                cy="20"
                r="16"
                class="value"
                pathLength="100"
                stroke-dasharray={`${stat.meter.percent} 100`}
                transform="rotate(-90 20 20)"
                data-meter-value
              />
            </svg>
          )}
          {stat.meter.kind === "ticks" && (
            <svg class="meter" viewBox="0 0 52 40" aria-hidden="true" focusable="false" data-meter="units">
              {Array.from({ length: stat.meter.count }, (_, i) => (
                <rect x={i * 7 + 2} y="8" width="4" height="24" rx="2" class="unit" data-meter-unit />
              ))}
            </svg>
          )}
          {stat.meter.kind === "dots" && (
            <svg class="meter" viewBox="0 0 40 40" aria-hidden="true" focusable="false" data-meter="units">
              {[
                [12, 12],
                [28, 12],
                [12, 28],
                [28, 28],
              ]
                .slice(0, stat.meter.count)
                .map(([cx, cy]) => (
                  <circle cx={cx} cy={cy} r="6" class="unit" data-meter-unit />
                ))}
            </svg>
          )}
          <span class="sr-only">{stat.display}</span>
          <span class="ticker" aria-hidden="true" data-final={stat.display}>
            <span data-count={stat.value} data-prefix={stat.prefix} data-suffix={stat.suffix}>
              {stat.display}
            </span>
          </span>
        </dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 0;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  dt {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display-lg);
    line-height: 1;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--lane-colour, var(--color-text));
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Meters sit beside the number, no taller than it, so the strip keeps its height (recruiter test). */
  .meter {
    flex-shrink: 0;
    width: 0.9em;
    height: 0.9em;
    overflow: visible;
  }

  .meter[data-meter="units"] {
    width: 1.15em;
  }

  .track {
    fill: none;
    stroke: var(--color-line);
    stroke-width: 5;
  }

  .value {
    fill: none;
    stroke: var(--lane-colour);
    stroke-width: 5;
    stroke-linecap: round;
  }

  .unit {
    fill: var(--lane-colour);
  }

  /* Counting never changes width: the final value, invisible, reserves the space (CLS). */
  .ticker {
    display: inline-grid;
  }

  .ticker > span,
  .ticker::after {
    grid-area: 1 / 1;
  }

  .ticker::after {
    content: attr(data-final);
    visibility: hidden;
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }

  @media (width >= 48rem) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-block: 1.5rem;
    }
  }

  /* In the hero's left column the strip is narrower: content-sized tracks keep "$7,000+" from colliding. */
  @media (width >= 64rem) {
    .strip {
      grid-template-columns: repeat(2, auto);
      column-gap: 1.25rem;
    }

    /* Beside a 3.25rem number the meter can be smaller; it still reads as a dial. */
    .meter {
      width: 0.7em;
      height: 0.7em;
    }

    .meter[data-meter="units"] {
      width: 0.9em;
    }

    dd {
      gap: 0.35rem;
    }
  }

  /* Four across once the left column is wide enough for the numbers and their meters (r5). */
  @media (width >= 80rem) {
    .strip {
      grid-template-columns: repeat(4, auto);
    }
  }
</style>
