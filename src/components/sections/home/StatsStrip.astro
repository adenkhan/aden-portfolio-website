---
import { stats } from "@/data/stats";
---

<!-- Lives inside the hero so the proof sits in the first screen on phones (p16 recruiter test). -->
<div class="stats" role="group" aria-labelledby="stats-title">
  <h2 id="stats-title" class="sr-only">
    Product marketing results in numbers
  </h2>
  <dl class="strip">
    {stats.map((stat) => (
      <div class="stat" data-lane={stat.lane} data-stat>
        <dt>{stat.label}</dt>
        <dd data-final={stat.display}>
          <span class="sr-only">{stat.display}</span>
          <span
            class="ticker"
            aria-hidden="true"
            data-count={stat.value}
            data-prefix={stat.prefix}
            data-suffix={stat.suffix}
            style={`min-inline-size: ${stat.display.length}ch`}
          >
            {stat.display}
          </span>
        </dd>
      </div>
    ))}
  </dl>
</div>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1rem;
    margin: 0;
    padding-block: 1rem 1.5rem;
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.25rem;
  }

  dt {
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-display-lg);
    line-height: 1;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--lane-colour, var(--color-text));
  }

  /* The counting copy keeps the final value's width, so counting never shifts layout. */
  .ticker {
    display: inline-block;
  }

  /* Zero-height copy of the final value: reserves its real rendered width, so content-sized tracks never resize. */
  dd::after {
    content: attr(data-final);
    display: block;
    height: 0;
    overflow: hidden;
    visibility: hidden;
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }

  @media (width >= 48rem) {
    .strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-block: 1.5rem;
    }
  }

  /* In the hero's left column the strip is narrower: content-sized tracks keep "$7,000+" from colliding. */
  @media (width >= 64rem) {
    .strip {
      grid-template-columns: repeat(4, auto);
      column-gap: 1.75rem;
    }
  }
</style>
