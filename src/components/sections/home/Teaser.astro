---
import { home } from "@/data/home";
---

<section class="container-site teaser" aria-labelledby="teaser-title">
  <div class="copy">
    <h2 id="teaser-title">{home.teaserHeading}</h2>
    <p class="measure">
      {home.teaser} <a href={home.teaserLink.href}>{home.teaserLink.label}</a>
    </p>
  </div>
  <!--
    Decorative. At rest (no JS, reduced motion) it reads as the equation: red, purple, blue.
    With motion, scrolling draws red and blue together into purple (docs/MOTION.md §10).
  -->
  <div class="collide" data-collide aria-hidden="true">
    <span class="orb red" data-orb="red"></span>
    <span class="orb purple" data-orb="purple"></span>
    <span class="orb blue" data-orb="blue"></span>
  </div>
</section>

<style>
  .teaser {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: 4rem 0;
  }

  h2 {
    margin: 0 0 1rem;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
  }

  p {
    margin: 0;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-muted);
  }

  a {
    color: var(--color-text);
    font-weight: 600;
  }

  .collide {
    --orb: 120px;
    position: relative;
    height: calc(var(--orb) * 1.4);
    overflow: hidden;
  }

  /* Positioned with left/margin so GSAP owns transform exclusively. */
  .orb {
    position: absolute;
    top: 50%;
    width: var(--orb);
    height: var(--orb);
    margin: calc(var(--orb) / -2) 0 0 calc(var(--orb) / -2);
    border-radius: 50%;
    /* Large soft gradients moved on every scroll frame: their own layer, never repainted. */
    will-change: transform, opacity;
  }

  .red {
    left: 22%;
    background: radial-gradient(circle, #ff4d6a 0%, #ff4d6aaa 25%, #ff4d6a33 50%, transparent 70%);
  }

  .blue {
    left: 78%;
    background: radial-gradient(circle, #3db0ff 0%, #3db0ffaa 25%, #3db0ff33 50%, transparent 70%);
  }

  .purple {
    left: 50%;
    background: radial-gradient(circle, #a77cff 0%, #a77cffaa 25%, #a77cff33 50%, transparent 70%);
  }

  @media (width >= 48rem) {
    .teaser {
      grid-template-columns: 1.1fr 0.9fr;
      gap: 3rem;
    }

    .collide {
      --orb: 160px;
    }
  }
</style>
