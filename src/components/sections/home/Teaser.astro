---
import { home } from "@/data/home";

const lanes = ["creative", "data", "both"] as const;
---

<!--
  Scroll moment (r2): three words only. At rest (no JS, reduced motion) the orbs sit apart and all
  three words show. With motion, red and blue converge into purple as the section scrolls, and the
  words arrive with it: CREATIVE and DATA as the orbs close in, GROWTH on impact (docs/MOTION.md §10).
-->
<section class="container-site teaser" aria-labelledby="teaser-title" data-teaser>
  <div class="collide" data-collide aria-hidden="true">
    <span class="orb red" data-orb="red"></span>
    <span class="orb purple" data-orb="purple"></span>
    <span class="orb blue" data-orb="blue"></span>
  </div>
  <h2 id="teaser-title" class="words" aria-label={home.scrollWords.join(" · ")}>
    {home.scrollWords.map((word, i) => (
      <>
        {i > 0 && (
          <span class="sep" aria-hidden="true">
            {" "}
            ·{" "}
          </span>
        )}
        <span class="word" data-lane={lanes[i]} data-word>
          {word}
        </span>
      </>
    ))}
  </h2>
</section>

<style>
  .teaser {
    display: grid;
    gap: 1.5rem;
    padding-block: 4rem 2rem;
  }

  .words {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin: 0;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
    letter-spacing: 0.02em;
  }

  .word {
    display: inline-block;
    color: var(--lane-colour);
  }

  .sep {
    color: var(--color-text-subtle);
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }

  .collide {
    --orb: 120px;
    position: relative;
    height: calc(var(--orb) * 1.4);
    overflow: hidden;
  }

  /* Positioned with left/margin so GSAP owns transform exclusively. */
  .orb {
    position: absolute;
    top: 50%;
    width: var(--orb);
    height: var(--orb);
    margin: calc(var(--orb) / -2) 0 0 calc(var(--orb) / -2);
    border-radius: 50%;
    /* Large soft gradients moved on every scroll frame: their own layer, never repainted. */
    will-change: transform, opacity;
  }

  .red {
    left: 22%;
    background: radial-gradient(circle, #ff4d6a 0%, #ff4d6aaa 25%, #ff4d6a33 50%, transparent 70%);
  }

  .blue {
    left: 78%;
    background: radial-gradient(circle, #3db0ff 0%, #3db0ffaa 25%, #3db0ff33 50%, transparent 70%);
  }

  .purple {
    left: 50%;
    background: radial-gradient(circle, #a77cff 0%, #a77cffaa 25%, #a77cff33 50%, transparent 70%);
  }

  /* Once the 3D world is running it draws this collision itself (scroll-scrubbed); the DOM orbs
     remain the version for reduced motion, no WebGL and no JavaScript. */
  :global([data-world][data-state="ready"] ~ main) .orb {
    visibility: hidden;
  }

  @media (width >= 48rem) {
    .words {
      font-size: var(--text-display-xl);
      line-height: var(--text-display-xl--line-height);
      gap: 0 1rem;
    }

    .collide {
      --orb: 160px;
    }
  }
</style>
