---
import { work } from "@/data/timeline";
import type { CaseStudy } from "@/data/types";
import Button from "@/components/ui/Button.astro";
import CaseVisual from "./CaseVisual.astro";

interface Props {
  study: CaseStudy;
  index: number;
  total: number;
}

const { study, index, total } = Astro.props;
const labels = work.caseLabels;
const titleId = `case-${study.id}-title`;
const count = study.count;
---

<!--
  One case study as a visual story (r4): title and company, then the visual (most of the space), then
  problem / move / result as three short captions that arrive with the visual's beats (data-beat).
  Fully understandable from the captions alone; the visual is decorative for assistive tech.
  Keyboard: each case is focusable; on desktop, focusing one scrolls the pinned sequence to it.
-->
<li
  class="case"
  id={`mission-${study.id}`}
  data-lane={study.lane}
  data-mission
  data-case-study
  data-case-index={index}
  tabindex="0"
  aria-labelledby={titleId}
>
  <div class="card" data-case-card>
    <!-- Full-screen case view (r8d): icon-only, revealed by script (it needs JavaScript). -->
    <button
      type="button"
      class="open"
      data-case-open
      hidden
      aria-label={`${work.takeover.open} ${study.title}`}
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <path d="M9.5 2.5h4v4M6.5 13.5h-4v-4M13.5 2.5 9 7M2.5 13.5 7 9" />
      </svg>
    </button>
    <header class="head">
      <p class="index" aria-hidden="true">
        {String(index + 1).padStart(2, "0")} / {String(total).padStart(2, "0")}
      </p>
      <h3 id={titleId}>{study.title}</h3>
      <p class="company">
        <span class="dot" aria-hidden="true"></span>
        <span class="sr-only">{labels.company}: </span>
        {study.company}
      </p>
    </header>

    <CaseVisual visual={study.visual} />

    <dl class="captions" data-mission-body>
      <div class="row" data-beat="1">
        <dt>
          <span class="sr-only">{labels.problem}</span>
          <span class="icon problem" aria-hidden="true">
            !
          </span>
        </dt>
        <dd>{study.problem}</dd>
      </div>
      <div class="row" data-beat="2">
        <dt>
          <span class="sr-only">{labels.move}</span>
          <span class="icon move" aria-hidden="true">
            →
          </span>
        </dt>
        <dd>{study.move}</dd>
      </div>
      <div class="row result" data-beat="3" data-mission-result>
        <dt>
          <span class="sr-only">{labels.result}</span>
          <span class="icon" aria-hidden="true">
            ▲
          </span>
        </dt>
        <dd>
          <span class="lead">
            {count ? (
              <>
                <span class="sr-only">{study.resultLead}</span>
                <span class="ticker" aria-hidden="true" data-final={study.resultLead}>
                  <span data-count={count.value} data-prefix={count.prefix} data-suffix={count.suffix}>
                    {study.resultLead}
                  </span>
                </span>
              </>
            ) : (
              study.resultLead
            )}
          </span>
          {study.resultRest && <span class="rest"> {study.resultRest}</span>}
        </dd>
      </div>
    </dl>
    {study.link && (
      <p class="link">
        <Button href={study.link.url} variant="secondary" target="_blank" rel="noopener">
          {study.link.label}
          <span class="sr-only"> (opens in a new tab)</span>
        </Button>
      </p>
    )}
  </div>
</li>

<style>
  .case {
    outline: none;
  }

  .case:focus-visible .card {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }

  .card {
    position: relative;
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background-color: color-mix(in srgb, var(--color-bg-surface) 88%, transparent);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
  }

  .open {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--color-text-muted);
    background-color: transparent;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    cursor: pointer;
    transition:
      color var(--duration-hover) ease,
      border-color var(--duration-hover) ease,
      transform var(--duration-press) ease-out;
  }

  .open[hidden] {
    display: none;
  }

  .open svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
  }

  @media (hover: hover) and (pointer: fine) {
    .open:hover {
      color: var(--lane-colour);
      border-color: var(--lane-colour);
    }
  }

  .open:active {
    transform: scale(0.94);
  }

  .open:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .head {
    display: grid;
    gap: 0.25rem;
    padding-right: 3rem;
  }

  .index {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    color: var(--lane-colour);
  }

  h3 {
    margin: 0;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
  }

  .company {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1rem;
    color: var(--color-text-subtle);
    overflow-wrap: anywhere;
  }

  .dot {
    flex-shrink: 0;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--lane-colour);
  }

  .card :global(.stage) {
    aspect-ratio: 720 / 300;
  }

  dl {
    display: grid;
    gap: 0.5rem;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 1.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.5rem;
  }

  dt {
    margin: 0;
  }

  dd {
    margin: 0;
    color: var(--color-text-muted);
    overflow-wrap: anywhere;
  }

  .icon {
    display: inline-grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-bg-base);
    background-color: var(--lane-colour);
  }

  .icon.problem {
    color: var(--color-text);
    background-color: transparent;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .icon.move {
    color: var(--lane-colour);
    background-color: transparent;
    box-shadow: inset 0 0 0 1px var(--lane-colour);
  }

  .link {
    margin: 0.25rem 0 0;
  }

  /* The real tool (r10) sizes itself on phones: the frame's own ratio, then the playbook row. */
  .card :global(.stage[data-case-visual="tool"]) {
    aspect-ratio: auto;
  }

  /* The result is the hero: its number (or line) in display type, the rest as its caption. */
  .result {
    align-items: center;
    margin-top: 0.25rem;
  }

  .result dd {
    color: var(--color-text);
  }

  .lead {
    font-family: var(--font-display);
    font-size: var(--text-display-lg);
    line-height: 1;
    font-weight: 900;
    font-variant-numeric: tabular-nums;
    color: var(--lane-colour);
  }

  .rest {
    font-family: var(--font-display);
    font-size: var(--text-title);
    font-weight: 800;
    color: var(--color-text);
  }

  /* Counting never changes width: the final value reserves the space (CLS). */
  .ticker {
    display: inline-grid;
  }

  .ticker > span,
  .ticker::after {
    grid-area: 1 / 1;
  }

  .ticker::after {
    content: attr(data-final);
    visibility: hidden;
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }

  @media (width >= 48rem) {
    .card {
      padding: 1.75rem 2rem;
    }
  }

  /* Desktop sequence (≥ 1024 px): one case per screen, the visual sized to the viewport height. */
  @media (width >= 64rem) {
    .card :global(.stage) {
      aspect-ratio: auto;
      height: clamp(220px, 40vh, 420px);
    }
  }
</style>
