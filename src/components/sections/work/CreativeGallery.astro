---
import Img from "@/components/ui/Img.astro";
import { assetSlots } from "@/data/assets";
import { work } from "@/data/timeline";

const slots = assetSlots.filter((s) => s.id.startsWith("gallery-"));
---

<section class="container-site block" id="gallery" aria-labelledby="gallery-title">
  <h2 id="gallery-title">{work.galleryHeading}</h2>
  <p class="note">{work.galleryNote}</p>
  <ul class="strip" tabindex="0" aria-label="Creative gallery, scrolls sideways" data-lenis-prevent>
    {slots.map((slot) => (
      <li>
        <figure>
          <Img asset={slot.id} widths={[300, 450, 600]} sizes="(min-width: 48rem) 300px, 70vw" />
        </figure>
      </li>
    ))}
  </ul>
  <p class="closing">
    <a href={work.closing.href}>{work.closing.label}</a>
  </p>
</section>

<style>
  .block {
    padding-block: 4rem 0;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
  }

  .note {
    margin: 0 0 1.5rem;
    color: var(--color-text-muted);
  }

  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70vw, 300px);
    gap: 1rem;
    margin: 0;
    padding: 0 0 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 1rem;
  }

  .strip li {
    scroll-snap-align: start;
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-line-strong);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--color-text-muted);
  }

  .closing {
    margin: 1.5rem 0 0;
    font-size: var(--text-body-lg);
  }

  .closing a {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
