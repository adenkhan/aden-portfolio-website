---
import Img from "@/components/ui/Img.astro";
import { assetSlots } from "@/data/assets";
import { work } from "@/data/timeline";

import { worstGallery } from "@/data/fixtures/worst";
import { isWorstCase } from "@/lib/fixtures";

const ids = isWorstCase()
  ? worstGallery
  : assetSlots.filter((s) => s.id.startsWith("gallery-")).map((s) => s.id);
---

<section class="container-site block" id="gallery" aria-labelledby="gallery-title" data-gallery>
  <h2 id="gallery-title">{work.galleryHeading}</h2>
  <ul
    class="strip"
    tabindex="0"
    aria-label="Creative gallery, scrolls sideways"
    data-lenis-prevent
    data-gallery-track
  >
    {ids.map((id) => (
      <li>
        <figure>
          <Img asset={id} widths={[300, 450, 600]} sizes="(min-width: 48rem) 300px, 70vw" />
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .block {
    padding-block: 4rem 0;
  }

  h2 {
    margin: 0 0 1.5rem;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
  }

  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(70vw, 300px);
    gap: 1rem;
    margin: 0;
    padding: 0 0 1rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scroll-padding-inline: 1rem;
  }

  /* Desktop pin (MOTION.md §11): GSAP moves the strip sideways; the section clips it. */
  .block:global(.pinned) {
    overflow-x: clip;
  }

  .block:global(.pinned) .strip {
    overflow: visible;
    scroll-snap-type: none;
  }

  .strip li {
    scroll-snap-align: start;
  }

  figure {
    margin: 0;
  }

  figure :global(img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border: 1px solid var(--color-line-strong);
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: var(--text-caption);
    line-height: var(--text-caption--line-height);
    color: var(--color-text-muted);
  }
</style>
