---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "secondary" | "ghost";
type Props = HTMLAttributes<"a"> & { variant?: Variant; href: string };

const { variant = "primary", class: className, href, ...rest } = Astro.props;
---

<a href={href} class:list={["btn", `btn-${variant}`, className]} {...rest}>
  <slot />
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color var(--duration-hover) ease,
      border-color var(--duration-hover) ease,
      color var(--duration-hover) ease,
      transform var(--duration-press) ease-out;
  }

  .btn:active {
    transform: scale(0.97);
  }

  .btn-primary {
    background-color: var(--color-creative);
    color: var(--color-on-accent);
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-text);
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }

  .btn-ghost {
    min-height: 44px;
    padding: 0.5rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .btn-primary:hover {
      background-color: color-mix(in oklab, var(--color-creative), white 8%);
    }

    .btn-secondary:hover {
      box-shadow: inset 0 0 0 1px var(--color-text);
    }

    .btn-ghost:hover {
      color: var(--color-text);
      text-decoration: underline;
    }
  }
</style>
