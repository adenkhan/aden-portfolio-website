---
import { Picture } from "astro:assets";
import { getSlot } from "@/data/assets";
import type { AssetKey } from "@/data/types";
import { getImageFor, isPlaceholder } from "@/lib/images";

interface Props {
  asset: AssetKey;
  widths: number[];
  sizes: string;
  /** Decorative images pass alt="" explicitly; otherwise the slot's alt from docs/SEO.md is used. */
  alt?: string;
  eager?: boolean;
  class?: string;
}

const { asset, widths, sizes, eager = false, class: className } = Astro.props;

// A slot whose file was deleted (or an unknown slot) renders a labelled box at the same size instead
// of failing the build, and warns, so a missing screenshot never takes the page down.
let meta: ReturnType<typeof getSlot> | undefined;
let image: ReturnType<typeof getImageFor> | undefined;
try {
  meta = getSlot(asset);
  image = getImageFor(asset);
} catch (error) {
  console.warn(`[Img] ${(error as Error).message}; rendering a fallback box.`);
}
const alt = Astro.props.alt ?? meta?.alt ?? "";
const ratio = meta ? `${meta.width} / ${meta.height}` : "4 / 5";
// The badge renders in dev only and never ships in a production build.
const showBadge = import.meta.env.DEV && image !== undefined && isPlaceholder(asset);
---

<div class:list={["img-slot", className]}>
  {image && meta ? (
    <Picture
      src={image}
      formats={["avif", "webp"]}
      fallbackFormat="webp"
      widths={widths}
      sizes={sizes}
      width={meta.width}
      height={meta.height}
      alt={alt}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager ? "high" : "auto"}
      decoding={eager ? "sync" : "async"}
    />
  ) : (
    <div
      class="img-missing"
      style={`aspect-ratio: ${ratio}`}
      role={alt ? "img" : undefined}
      aria-label={alt || undefined}
    >
      <span aria-hidden="true">Image coming soon</span>
    </div>
  )}
  {showBadge && <span class="placeholder-badge">placeholder</span>}
</div>

<style>
  .img-slot {
    position: relative;
  }

  .img-slot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .img-missing {
    display: grid;
    place-items: center;
    width: 100%;
    background-color: var(--color-bg-raised);
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
  }

  .placeholder-badge {
    position: absolute;
    top: 0.5rem;
    left: 0.5rem;
    padding: 0.125rem 0.5rem;
    border-radius: var(--radius-sm);
    background-color: var(--color-bg-void);
    color: var(--color-text);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    box-shadow: inset 0 0 0 1px var(--color-line-strong);
  }
</style>
