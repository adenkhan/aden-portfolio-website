---
import type { Lane } from "@/data/types";

interface Props {
  lane: Lane;
}

const { lane } = Astro.props;
const label: Record<Lane, string> = { creative: "Creative", data: "Data", both: "Both" };
---

<span class="lane" data-lane={lane}>
  <span class="dot" aria-hidden="true"></span>
  {label[lane]}
</span>

<style>
  .lane {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-mono-label);
    color: var(--color-text-muted);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background-color: var(--lane-colour);
  }

  [data-lane="creative"] {
    --lane-colour: var(--color-creative);
  }

  [data-lane="data"] {
    --lane-colour: var(--color-data);
  }

  [data-lane="both"] {
    --lane-colour: var(--color-growth);
  }
</style>
