---
import { seo } from "@/data/seo";
import type { PageId } from "@/data/types";

interface Props {
  page: PageId;
  /** Opt in to the headline reveal (docs/MOTION.md moment 3). */
  reveal?: boolean;
}

const { page, reveal = false } = Astro.props;
const meta = seo[page];
---

<h1 class="page-title" data-reveal={reveal ? "headline" : undefined}>
  {meta.h1}
  {meta.h1Sub && <span class="h1-sub">{meta.h1Sub}</span>}
</h1>

<style>
  .page-title {
    margin: 0;
    font-size: var(--text-display-lg);
    line-height: var(--text-display-lg--line-height);
    font-weight: 900;
    letter-spacing: -0.01em;
  }

  @media (width >= 64rem) {
    .page-title {
      font-size: var(--text-display-page);
    }
  }
</style>
