---
import ContactForm from "@/components/sections/contact/ContactForm.astro";
import TerminalPanel from "@/components/sections/contact/TerminalPanel.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { contact } from "@/data/timeline";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout page="contact">
  <header class="container-site page-head">
    <PageTitle page="contact" reveal />
    <p class="measure intro">
      {contact.line.slice(0, contact.line.lastIndexOf(" ") + 1)}
      <span class="wave" data-wave>
        {contact.line.slice(contact.line.lastIndexOf(" ") + 1)}
      </span>
    </p>
  </header>
  <TerminalPanel />
  <ContactForm />
</BaseLayout>

<style>
  .page-head {
    padding-top: 3rem;
  }

  .intro {
    margin: 1.5rem 0 0;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-muted);
  }

  /* "hi." waves once (r5); inline-block so it can rotate. */
  .wave {
    display: inline-block;
  }
</style>
