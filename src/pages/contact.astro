---
import ContactForm from "@/components/sections/contact/ContactForm.astro";
import TerminalPanel from "@/components/sections/contact/TerminalPanel.astro";
import PageTitle from "@/components/ui/PageTitle.astro";
import { contact } from "@/data/timeline";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { contactJsonLd } from "@/lib/jsonld";
---

<BaseLayout page="contact" jsonLd={contactJsonLd()}>
  <header class="container-site page-head">
    <!-- The avatar's station on Contact (r9): she waves as the page enters view. -->
    <div class="avatar-anchor" aria-hidden="true" data-avatar-anchor="contact"></div>
    <PageTitle page="contact" reveal />
    <p class="measure intro">
      {contact.line.slice(0, contact.line.lastIndexOf(" ") + 1)}
      <span class="wave" data-wave>
        {contact.line.slice(contact.line.lastIndexOf(" ") + 1)}
      </span>
    </p>
  </header>
  <TerminalPanel />
  <ContactForm />
</BaseLayout>

<style>
  .page-head {
    position: relative;
    padding-top: 3rem;
  }

  .avatar-anchor {
    position: absolute;
    top: 0.25rem;
    right: 1rem;
    width: 2.2rem;
    aspect-ratio: 4 / 5;
    pointer-events: none;
  }

  @media (width >= 64rem) {
    .avatar-anchor {
      top: 1.5rem;
      right: 2.5rem;
      width: 13rem;
    }
  }

  .intro {
    margin: 1.5rem 0 0;
    font-size: var(--text-body-lg);
    line-height: var(--text-body-lg--line-height);
    color: var(--color-text-muted);
  }

  /* "hi." waves once (r5); inline-block so it can rotate. */
  .wave {
    display: inline-block;
  }
</style>
