import Teaser from "@/components/sections/home/Teaser.astro";
import IntroGate from "@/components/motion/IntroGate.astro";
import IntroOverlay from "@/components/motion/IntroOverlay.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homeJsonLd } from "@/lib/jsonld";
---

<BaseLayout page="home" jsonLd={homeJsonLd()}>
  <IntroGate slot="head" />
  <IntroOverlay slot="before-nav" />
  <Hero />
  <Teaser />
</BaseLayout>
